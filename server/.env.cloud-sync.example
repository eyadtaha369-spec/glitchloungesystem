# Background Cloud Sync — the LOCAL SERVER's own settings (this is
# separate from the main .env in the project's root folder, which
# controls which backend the APP itself talks to).
#
# Once this is set up, the café's app can go back to talking to this
# local server directly (fast, instant order confirmation, exactly
# like before cloud mode existed) — while THIS server quietly pushes
# a fresh copy of its data up to the cloud in the background every
# ~30 seconds, so the owner's phone and the web app still stay
# roughly current, just with a short delay instead of zero delay.
#
# HOW TO USE THIS FILE:
#   1. Copy this file to ".env" (that exact name) INSIDE THE
#      "server" FOLDER SPECIFICALLY — not the project's root folder,
#      which has its own separate .env for a different purpose.
#   2. Fill in the same real Apps Script URL and secret you already
#      use elsewhere (the "Migrate to Cloud" tool, or the root .env).
#   3. Make sure the café's main project root .env points BACK at
#      this local server (APPS_SCRIPT_URL=http://127.0.0.1:4000/),
#      and launch with start-local.bat / run.vbs from now on — NOT
#      the cloud versions, since this local-first setup is what
#      restores instant order confirmation.
#   4. Restart the local server (stop-local.bat, then start-local.bat
#      or run.vbs again) so it picks up this file.

CLOUD_SYNC_URL=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID_HERE/exec
CLOUD_SYNC_SECRET=paste-your-real-secret-here

# Optional — how often to push, in milliseconds. Defaults to 30000
# (30 seconds) if not set. Lower means the owner's phone catches up
# faster, but pushes more often; higher means less frequent traffic.
CLOUD_SYNC_INTERVAL_MS=30000
