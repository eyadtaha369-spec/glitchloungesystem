# CLOUD MODE — the café device talks DIRECTLY to the same cloud
# backend the web app uses, instead of its own separate local
# database. This is what makes every device (café, laptop, the
# owner's phone via the web app) see the exact same live data.
#
# HOW TO USE THIS FILE:
#   1. Copy this file to ".env" (that exact name) in the project's
#      root folder — NOT the server folder.
#   2. Replace the two placeholder values below with your real
#      Apps Script deployment URL and secret (the same ones you'd
#      use in the "Migrate to Cloud" tool on the Setup page).
#   3. Run start-cloud.bat instead of start-local.bat from now on.
#
# Do NOT commit the real ".env" file — it holds a real secret and is
# already git-ignored. This .example file has no real secret in it,
# so it's safe to keep in the repo as a template for future setup.

APPS_SCRIPT_URL=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID_HERE/exec
APPS_SCRIPT_SECRET=paste-your-real-secret-here

# This one doesn't need to change — it's for the web session cookie,
# unrelated to which backend the app talks to. Generate a random
# value once and reuse it (openssl rand -hex 32, or any long random
# string works).
SESSION_SECRET=generate-a-long-random-string-here
